{
  "manifestVersion": 2,
  "id": "council-flow",
  "name": "Council Flow",
  "version": "0.2.0",
  "description": "Say what the council should do and press Run: council-flow starts a local-only audit or a coding run in a new Orca terminal, and a live Workflows list shows each run's stage, findings and when it waits for your approve.",
  "author": {
    "name": "tomi204"
  },
  "repository": "https://github.com/tomi204/council-flow",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "plugin/src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "council-flow",
        "title": "Council Flow",
        "icon": "bot",
        "entry": "plugin/src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "council-flow.audit",
        "title": "Council Flow: Run this workspace's last audit prompt again",
        "when": "workspace"
      },
      {
        "id": "council-flow.code",
        "title": "Council Flow: Run this workspace's last coding prompt again",
        "when": "workspace"
      },
      {
        "id": "council-flow.resume",
        "title": "Council Flow: Resume the latest interrupted run",
        "when": "workspace"
      },
      {
        "id": "council-flow.jump",
        "title": "Council Flow: Show the terminal of the run waiting for approve",
        "when": "global"
      },
      {
        "id": "council-flow.doctor",
        "title": "Council Flow: Run doctor in a new terminal",
        "when": "workspace"
      }
    ],
    "statusBarItems": [
      {
        "id": "council-flow-status",
        "text": "Council Flow",
        "icon": "bot",
        "tooltip": "Council Flow workflows",
        "command": "council-flow.jump"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "storage:own"
    }
  ]
}
